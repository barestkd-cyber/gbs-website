---
import type { Service } from '../data/services';
interface Props { service: Service; detailed?: boolean }
const { service, detailed = false } = Astro.props;
---
<article class="service reveal" id={detailed ? undefined : `svc-${service.id}`}>
  <div class="top">
    <span class="step" aria-hidden="true">0{service.step}</span>
    <h3>{service.name}</h3>
    <p class="tagline">{service.tagline}</p>
  </div>
  <p class="message">{service.message}</p>
  <ul class="check-list">
    {service.features.map((f) => <li>{f}</li>)}
  </ul>
  <p class="structure">
    {service.id === 'custom'
      ? 'Scoped up front and built on a Grizzly base.'
      : 'One-time setup, then a monthly plan.'}
  </p>
</article>

<style>
  .service {
    display: flex; flex-direction: column; gap: 1rem;
    background: var(--white); border: 1px solid var(--line); border-radius: var(--radius-lg);
    padding: clamp(1.4rem, 3vw, 1.9rem); height: 100%;
    border-top: 4px solid var(--tan);
  }
  .service:nth-child(2) { border-top-color: var(--bear); }
  .service:nth-child(3) { border-top-color: var(--ink); }
  .service:nth-child(4) { border-top-color: var(--olive); }
  .step {
    display: block; font-family: var(--font-head); font-stretch: 125%; font-weight: 800; font-size: 0.85rem;
    letter-spacing: 0.12em; color: var(--tan); margin-bottom: 0.5rem;
  }
  h3 { margin-bottom: 0.3rem; }
  .tagline { margin: 0; font-weight: 600; color: var(--bear); }
  .message { margin: 0; color: var(--text-muted); }
  .check-list { font-size: 1.02rem; }
  .structure {
    margin: auto 0 0; padding-top: 1rem; border-top: 1px dashed var(--line);
    font-size: 0.95rem; color: var(--olive); font-weight: 600;
  }
</style>
