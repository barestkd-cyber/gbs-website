---
// BaresTKD CRM is a separate martial arts product, never a Grizzly CRM tier.
// Only list capabilities that exist in the live BaresTKD system.
import { u } from '../lib/url';
const capabilities = [
  'Students and families',
  'Memberships and agreements',
  'Recurring billing and POS',
  'Attendance and check-in',
  'Class calendar',
  'Rank awards',
];
---
<aside class="ma reveal" aria-labelledby="ma-title">
  <div class="ma-copy">
    <p class="ma-label">Martial arts software</p>
    <h3 id="ma-title">For martial arts schools: BaresTKD CRM</h3>
    <p>A separate, purpose-built system for martial arts schools, developed from the software that runs Bares Taekwondo Fitness every day. It is its own product, not a Grizzly CRM tier.</p>
    <a href={u('/our-work#bares-taekwondo')}>See how Bares Taekwondo uses it <span aria-hidden="true">→</span></a>
  </div>
  <ul class="check-list ma-list">{capabilities.map((c) => <li>{c}</li>)}</ul>
</aside>

<style>
  .ma {
    display: grid; gap: 1.25rem 2.5rem; grid-template-columns: 1fr; align-items: center;
    margin-top: 2rem; padding: clamp(1.25rem, 3vw, 1.75rem); border: 1px dashed var(--sand); border-radius: var(--radius-lg); background: var(--sand-100);
  }
  @media (min-width: 900px) { .ma { grid-template-columns: 1.3fr 1fr; } }
  .ma-label {
    margin: 0 0 0.4rem; font-family: var(--font-head); font-stretch: 120%; font-size: 0.78rem; font-weight: 700;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--olive);
  }
  h3 { margin-bottom: 0.5rem; }
  .ma-copy p:not(.ma-label) { color: var(--text-muted); margin-bottom: 0.75rem; }
  .ma-copy a { font-weight: 700; }
  .ma-list { grid-template-columns: repeat(2, minmax(0, 1fr)); font-size: 1rem; }
</style>
