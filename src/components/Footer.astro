---
import Logo from './Logo.astro';
import { siteConfig, navigation } from '../config/site';
const { contact } = siteConfig;
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container grid">
    <div class="about">
      <a href="/" aria-label="Grizzly Business Systems home"><Logo width={150} /></a>
      <p>Websites, website care, and business systems for local small businesses.</p>
      <p class="area">{siteConfig.serviceAreaLine}</p>
    </div>

    <nav aria-label="Footer">
      <h2 class="col-title">Pages</h2>
      <ul>{navigation.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
    </nav>

    <div>
      <h2 class="col-title">Get in touch</h2>
      <ul>
        {contact.phone && <li><a href={`tel:${contact.phone.replace(/[^\d+]/g, '')}`}>{contact.phone}</a></li>}
        {contact.email && <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>}
        <li><a href={siteConfig.primaryCTA.href}>{siteConfig.primaryCTA.label}</a></li>
        <li class="muted">{contact.city}, {contact.region}</li>
      </ul>
    </div>
  </div>
  <div class="container legal">
    <p>&copy; {year} {siteConfig.businessName}</p>
  </div>
</footer>

<style>
  .site-footer { background: var(--white); border-top: 1px solid var(--line); padding-top: clamp(3rem, 7vw, 4.5rem); font-size: 1rem; }
  .grid { display: grid; gap: 2.5rem; grid-template-columns: 1fr; }
  @media (min-width: 760px) { .grid { grid-template-columns: 1.6fr 1fr 1fr; } }
  .about p { color: var(--text-muted); max-width: 26rem; margin-top: 1rem; }
  .about .area { font-weight: 600; color: var(--ink); }
  .col-title {
    font-size: 0.8rem; font-stretch: 120%; letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--olive); margin-bottom: 1rem;
  }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.2rem; }
  li a { display: inline-block; padding: 0.3rem 0; color: var(--ink); text-decoration: none; }
  li a:hover { color: var(--bear); text-decoration: underline; }
  .muted { color: var(--text-muted); padding-top: 0.3rem; }
  .legal { margin-top: 3rem; padding-block: 1.5rem; border-top: 1px solid var(--line); color: var(--text-muted); font-size: 0.92rem; }
  .legal p { margin: 0; }
</style>
