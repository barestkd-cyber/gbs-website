---
import { siteConfig } from '../config/site';
import { u } from '../lib/url';
interface Props { label?: string; href?: string; variant?: 'primary' | 'light' | 'outline'; size?: 'md' | 'lg'; class?: string }
const {
  label = siteConfig.primaryCTA.label,
  href = siteConfig.primaryCTA.href,
  variant = 'primary',
  size = 'md',
  class: className,
} = Astro.props;
---
<a href={u(href)} class:list={['btn', `btn--${variant}`, `btn--${size}`, className]}>
  {label}
  <svg aria-hidden="true" width="18" height="18" viewBox="0 0 20 20" fill="none"><path d="M4 10h11m-4.5-5L15 10l-4.5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
</a>

<style>
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.55rem;
    font-family: var(--font-head); font-stretch: 108%; font-weight: 700; letter-spacing: 0.005em;
    text-decoration: none; border-radius: var(--radius); border: 2px solid transparent;
    min-height: 48px; padding: 0.7rem 1.25rem; font-size: 1rem; line-height: 1.2;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
  }
  .btn svg { transition: transform 0.15s ease; flex: none; }
  .btn:hover svg { transform: translateX(3px); }
  .btn--lg { min-height: 56px; padding: 0.9rem 1.6rem; font-size: 1.08rem; }
  .btn--primary { background: var(--bear); color: var(--white); }
  .btn--primary:hover { background: var(--bear-deep); color: var(--white); }
  .btn--light { background: var(--cream); color: var(--ink); }
  .btn--light:hover { background: var(--white); color: var(--ink); }
  .btn--outline { border-color: var(--bear); color: var(--bear); background: transparent; }
  .btn--outline:hover { background: var(--bear); color: var(--white); }
</style>
