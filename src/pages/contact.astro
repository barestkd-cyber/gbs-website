---
import { u } from '../lib/url';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';

const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? '';
const { contact } = siteConfig;

const needs = [
  'I need a website',
  'I need help with my current website',
  'I need a CRM/business system',
  'I need payments/POS',
  'I need something custom',
  'I am not sure yet',
];
---
<BaseLayout
  title="Tell Us About Your Business"
  description="Tell Grizzly Business Systems what is going on in your business. A short, free first conversation, whether you're in East Texas or beyond."
>
  <section class="page">
    <div class="container layout">
      <div class="intro">
        <span class="eyebrow">Contact</span>
        <h1>Tell us about your business.</h1>
        <p class="lead">What do you need, and what is getting in the way? A few sentences is plenty. We will get back to you to set up a short conversation.</p>
        <ul class="check-list promises">
          <li>The first conversation is free and short</li>
          <li>No financial documents or sensitive information needed</li>
          <li>You will hear back from a real person, not an automated sequence</li>
        </ul>
        {(contact.phone || contact.email) && (
          <div class="direct">
            <h2>Prefer to reach out directly?</h2>
            {contact.phone && <p><a href={`tel:${contact.phone.replace(/[^\d+]/g, '')}`}>{contact.phone}</a></p>}
            {contact.email && <p><a href={`mailto:${contact.email}`}>{contact.email}</a></p>}
          </div>
        )}
        <p class="area">{siteConfig.serviceAreaLine}</p>
      </div>

      <div class="form-card">
        <form id="intake" action={endpoint || undefined} method="post" novalidate data-endpoint={endpoint}>
          <div class="row two">
            <div class="field">
              <label for="name">Your name <span class="req" aria-hidden="true">*</span></label>
              <input id="name" name="name" type="text" autocomplete="name" required />
              <p class="error" id="name-error" hidden>Please enter your name.</p>
            </div>
            <div class="field">
              <label for="business">Business name <span class="req" aria-hidden="true">*</span></label>
              <input id="business" name="business" type="text" autocomplete="organization" required />
              <p class="error" id="business-error" hidden>Please enter your business name.</p>
            </div>
          </div>

          <div class="row two">
            <div class="field">
              <label for="email">Email <span class="req" aria-hidden="true">*</span></label>
              <input id="email" name="email" type="email" autocomplete="email" inputmode="email" required />
              <p class="error" id="email-error" hidden>Please enter a valid email address.</p>
            </div>
            <div class="field">
              <label for="phone">Phone</label>
              <input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" />
            </div>
          </div>

          <div class="field">
            <label for="website">Current website <span class="opt">(optional)</span></label>
            <input id="website" name="website" type="text" inputmode="url" placeholder="yourbusiness.com" autocomplete="url" />
          </div>

          <fieldset class="field">
            <legend>What do you need help with? <span class="req" aria-hidden="true">*</span></legend>
            <div class="choices">
              {needs.map((n, i) => (
                <label class="choice">
                  <input type="radio" name="need" value={n} required={i === 0} />
                  <span>{n}</span>
                </label>
              ))}
            </div>
            <p class="error" id="need-error" hidden>Please choose the closest option.</p>
          </fieldset>

          <div class="field">
            <label for="message">What is driving you crazy right now? <span class="req" aria-hidden="true">*</span></label>
            <textarea id="message" name="message" rows="5" required placeholder="For example: our website is outdated, leads get lost in email, we track customers in three different places…"></textarea>
            <p class="error" id="message-error" hidden>Tell us a little about what is going on.</p>
          </div>

          <fieldset class="field">
            <legend>Preferred way to reach you <span class="opt">(optional)</span></legend>
            <div class="choices inline">
              {['Phone call', 'Text', 'Email'].map((m) => (
                <label class="choice"><input type="radio" name="contact_method" value={m} /><span>{m}</span></label>
              ))}
            </div>
          </fieldset>

          <!-- Spam trap: real people never see or fill this. -->
          <div class="hp" aria-hidden="true">
            <label for="company_url">Leave this empty</label>
            <input id="company_url" name="company_url" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <p class="required-note"><span class="req" aria-hidden="true">*</span> Required</p>
          <button type="submit" class="submit">
            <span class="label">Send it over</span>
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 20 20" fill="none"><path d="M4 10h11m-4.5-5L15 10l-4.5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <p class="status" role="status" aria-live="polite"></p>
        </form>

        <div class="success" id="success" hidden tabindex="-1">
          <img src={u('/brand/gbs-mark.png')} alt="" width="56" height="56" />
          <h2>Thanks. We got it.</h2>
          <p>We will read what you sent and get back to you soon to set up a short conversation.</p>
          <a href={u('/')}>Back to the home page</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('intake') as HTMLFormElement | null;
  const success = document.getElementById('success') as HTMLElement | null;

  if (form && success) {
    const status = form.querySelector('.status') as HTMLElement;
    const button = form.querySelector('.submit') as HTMLButtonElement;
    const endpoint = form.dataset.endpoint;

    const show = (id: string, on: boolean) => {
      const el = document.getElementById(`${id}-error`);
      if (el) el.hidden = !on;
      const input = form.querySelector<HTMLElement>(`[name="${id}"]`);
      if (input) {
        input.setAttribute('aria-invalid', String(on));
        if (on) input.setAttribute('aria-describedby', `${id}-error`);
        else input.removeAttribute('aria-describedby');
      }
    };

    const validate = () => {
      const data = new FormData(form);
      const email = String(data.get('email') || '').trim();
      const checks: Record<string, boolean> = {
        name: !!String(data.get('name') || '').trim(),
        business: !!String(data.get('business') || '').trim(),
        email: /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email),
        need: !!data.get('need'),
        message: !!String(data.get('message') || '').trim(),
      };
      let first: string | null = null;
      for (const [k, ok] of Object.entries(checks)) {
        show(k, !ok);
        if (!ok && !first) first = k;
      }
      if (first) form.querySelector<HTMLElement>(`[name="${first}"]`)?.focus();
      return !first;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.textContent = '';
      if (!validate()) return;

      const data = new FormData(form);
      if (data.get('company_url')) return; // bot

      if (!endpoint) {
        status.textContent = 'The online form is not connected yet. Please try again soon.';
        status.classList.add('is-error');
        return;
      }

      button.disabled = true;
      button.querySelector('.label')!.textContent = 'Sending…';
      try {
        const res = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(String(res.status));
        form.hidden = true;
        success.hidden = false;
        success.focus();
      } catch {
        status.textContent = 'Something went wrong sending the form. Please try again in a minute.';
        status.classList.add('is-error');
        button.disabled = false;
        button.querySelector('.label')!.textContent = 'Send it over';
      }
    });

    form.addEventListener('input', (e) => {
      const t = e.target as HTMLInputElement;
      if (t.getAttribute('aria-invalid') === 'true') show(t.name, false);
    });
  }
</script>

<style>
  .page { padding-block: clamp(2.5rem, 7vw, 5rem) var(--section); }
  .layout { display: grid; gap: clamp(2rem, 5vw, 4rem); grid-template-columns: 1fr; align-items: start; }
  @media (min-width: 980px) { .layout { grid-template-columns: 0.9fr 1.1fr; } .intro { position: sticky; top: 6.5rem; } }
  .intro h1 { font-size: clamp(2.3rem, 5.5vw, 3.6rem); }
  .promises { margin: 1.5rem 0 2rem; }
  .direct { padding: 1.2rem 1.4rem; background: var(--white); border: 1px solid var(--line); border-radius: var(--radius-lg); margin-bottom: 1.5rem; }
  .direct h2 { font-size: 1.1rem; margin-bottom: 0.5rem; }
  .direct p { margin: 0.2rem 0; font-weight: 700; }
  .area { font-weight: 700; color: var(--bear); }

  .form-card { background: var(--white); border: 1px solid var(--line); border-radius: var(--radius-lg); padding: clamp(1.25rem, 4vw, 2.25rem); box-shadow: var(--shadow); }
  .row.two { display: grid; gap: 0 1.25rem; grid-template-columns: 1fr; }
  @media (min-width: 620px) { .row.two { grid-template-columns: 1fr 1fr; } }
  .field { margin: 0 0 1.35rem; border: 0; padding: 0; min-width: 0; }
  label, legend { display: block; font-weight: 700; font-size: 1rem; margin-bottom: 0.4rem; color: var(--ink); padding: 0; }
  .req { color: var(--bear); }
  .opt { font-weight: 400; color: var(--text-muted); }
  input[type='text'], input[type='email'], input[type='tel'], textarea {
    width: 100%; font: inherit; font-size: 1.05rem; color: var(--ink);
    padding: 0.75rem 0.9rem; min-height: 50px; border: 1.5px solid #cfc3ae; border-radius: var(--radius); background: var(--cream);
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }
  textarea { resize: vertical; min-height: 140px; line-height: 1.5; }
  input:focus, textarea:focus { outline: none; border-color: var(--bear); background: var(--white); box-shadow: 0 0 0 3px rgb(89 59 30 / 0.15); }
  [aria-invalid='true'] { border-color: #a3341f !important; }
  ::placeholder { color: #8d8a84; }
  .error { color: #a3341f; font-size: 0.95rem; font-weight: 600; margin: 0.35rem 0 0; }

  .choices { display: grid; gap: 0.5rem; grid-template-columns: 1fr; }
  @media (min-width: 620px) { .choices { grid-template-columns: 1fr 1fr; } }
  .choices.inline { display: flex; flex-wrap: wrap; }
  .choice {
    display: flex; align-items: center; gap: 0.65rem; margin: 0; font-weight: 600; font-size: 1rem; cursor: pointer;
    padding: 0.7rem 0.9rem; min-height: 48px; border: 1.5px solid var(--line); border-radius: var(--radius); background: var(--cream);
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }
  .choice:hover { border-color: var(--tan); }
  .choice:has(input:checked) { border-color: var(--bear); background: #f5ecdf; }
  .choice input { accent-color: var(--bear); width: 1.1rem; height: 1.1rem; margin: 0; flex: none; }

  .hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .required-note { font-size: 0.92rem; color: var(--text-muted); }
  .submit {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.55rem; width: 100%;
    min-height: 56px; padding: 0.9rem 1.6rem; border: 0; border-radius: var(--radius); cursor: pointer;
    background: var(--bear); color: var(--white); font-family: var(--font-head); font-stretch: 108%; font-weight: 700; font-size: 1.1rem;
    transition: background-color 0.15s ease;
  }
  .submit:hover { background: var(--bear-deep); }
  .submit:disabled { opacity: 0.7; cursor: progress; }
  .status { margin: 1rem 0 0; font-weight: 600; }
  .status:empty { display: none; }
  .status.is-error { color: #a3341f; }

  .success { text-align: center; padding: 2rem 0.5rem; outline: none; }
  .success img { margin: 0 auto 1rem; }
  .success p { color: var(--text-muted); }
  .success a { font-weight: 700; }
</style>
